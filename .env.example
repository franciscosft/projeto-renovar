# ─── SQL Server ────────────────────────────────────────────────────
# SA password must meet SQL Server complexity requirements:
# min. 8 chars, uppercase, lowercase, digit and special character.
SA_PASSWORD=YourStrong@Passw0rd

# Database name created on first startup
MSSQL_DB=bd_renovar_dev

# Login used by the Spring Boot application
MSSQL_USERNAME=SA

# ─── RabbitMQ ──────────────────────────────────────────────────────
RABBITMQ_USER=admin
RABBITMQ_PASS=admin

# ─── Notes ─────────────────────────────────────────────────────────
# 1. Copy this file to .env and fill in the values:
#       cp .env.example .env
#
# 2. Start the stack:
#       docker compose up --build
#
# 3. RabbitMQ management UI: http://localhost:15672
#    Spring Boot API:         http://localhost:8080
#    Swagger UI:              http://localhost:8080/swagger-ui/index.html